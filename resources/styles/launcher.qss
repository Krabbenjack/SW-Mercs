/* SW-Mercs launcher-specific overrides. Shared base: swmercs.qss. */
QMainWindow { background: #101923; }
QWidget#central { background: #101923; }
QLabel { color: #B3C4D2; font-family: "Segoe UI", Arial; font-size: 11pt; }
QLabel#brand { color: #E6EDF5; font-size: 34pt; font-weight: bold; }
QLabel#heading { color: #E6EDF5; font-size: 20pt; font-weight: bold; }
QPushButton { background: #1B2C3B; color: #EFF7FF; border: 1px solid #3B5366; border-radius: 9px; padding: 12px; font-size: 11pt; text-align: center; }
QPushButton:hover { background: #273F54; border-color: #75B6E4; }
QPushButton:pressed { background: #365674; }
QPushButton:disabled { color: #778797; border-color: #344657; }
QPushButton#primary, QPushButton#module { background: #22384C; }
QPushButton#primary:hover, QPushButton#module:hover { background: #273F54; border-color: #75B6E4; }

